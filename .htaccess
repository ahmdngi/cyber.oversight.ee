# Cyber Oversight - Maritime Cybersecurity
# Apache configuration for GitHub Pages / Apache hosting
# Last updated: 2026

# =============================================================================
# COMPRESSION & PERFORMANCE
# =============================================================================

# Enable compression for text-based assets
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript text/xml text/plain
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject application/x-font-ttf font/opentype font/ttf font/eot font/otf
    AddOutputFilterByType DEFLATE image/svg+xml
    
    # Compression level (1-9, 6 is good balance)
    DeflateCompressionLevel 6
    
    # Don't compress already compressed files
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|ico|svgz|woff2?)$ no-gzip dont-vary
    
    # Vary header for proxies
    Header append Vary Accept-Encoding env=!dont-vary
</IfModule>

# =============================================================================
# BROWSER CACHING
# =============================================================================

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # HTML - no cache (dynamic content)
    ExpiresByType text/html "access plus 0 seconds"
    
    # CSS & JS - 1 year with versioning
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # Images - 1 year
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Fonts - 1 year
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    
    # Data files
    ExpiresByType application/json "access plus 1 week"
    ExpiresByType application/xml "access plus 1 week"
    ExpiresByType text/xml "access plus 1 week"
</IfModule>

# Cache-Control headers for modern browsers
<IfModule mod_headers.c>
    # HTML - no cache, must revalidate
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    
    # Static assets - long-term cache with immutable
    <FilesMatch "\.(css|js|json|xml)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Images & fonts - long-term cache
    <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg|ico|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy (feature policy)
    Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
    
    # CSP - restrictive but allows needed resources
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cloud.umami.is; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://cloud.umami.is https://nominatim.openstreetmap.org https://*.tile.openstreetmap.org; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
    
    # Remove server signature
    Header unset Server
    Header unset X-Powered-By
</IfModule>

# =============================================================================
# CLEAN URLs - Remove .html extension
# =============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Remove .html extension
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [NC,L]
    
    # Redirect .html URLs to clean URLs (SEO friendly)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html\s [NC]
    RewriteRule ^ %1 [R=301,L,NE]
    
    # Remove trailing slash from non-directories
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L,NE]
    
    # Force HTTPS (when not on GitHub Pages)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
    
    # www to non-www (or vice versa - pick one)
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# =============================================================================
# MIME TYPES
# =============================================================================

<IfModule mod_mime.c>
    # JavaScript
    AddType application/javascript js mjs
    
    # Web App Manifest
    AddType application/manifest+json webmanifest
    
    # Fonts
    AddType font/woff2 woff2
    AddType font/woff woff
    AddType application/vnd.ms-fontobject eot
    AddType font/ttf ttf
    AddType font/otf otf
    
    # Images
    AddType image/avif avif
    AddType image/webp webp
    
    # Data
    AddType application/json json
    AddType application/xml xml
    AddType text/xml xml
</IfModule>

# =============================================================================
# ERROR PAGES
# =============================================================================

ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# =============================================================================
# SECURITY
# =============================================================================

# Block access to hidden files and directories
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} \.(git|svn|env|log|sql|bak|backup|swp|tmp)$ [NC,OR]
    RewriteCond %{REQUEST_URI} /\.(git|svn|htaccess|htpasswd|env) [NC]
    RewriteRule ^ - [F,L]
</IfModule>

# Block access to sensitive files
<FilesMatch "^\.(htaccess|htpasswd|env|gitignore|gitattributes)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(bak|backup|log|sql|tmp|swp)$">
    Require all denied
</FilesMatch>

# =============================================================================
# ENABLE KEEP-ALIVE
# =============================================================================

<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>

# =============================================================================
# ENABLE HTTP/2 PUSH HINTS (via Link headers)
# =============================================================================

<IfModule mod_headers.c>
    # Preload critical CSS
    <FilesMatch "index\.html$">
        Header add Link "<tokens.css>; rel=preload; as=style"
        Header add Link "<favicon.svg>; rel=preload; as=image; type=image/svg+xml"
        Header add Link "<logo-full.png>; rel=preload; as=image; type=image/png"
    </FilesMatch>
    
    # Preload critical JS
    <FilesMatch "\.html$">
        Header add Link "<theme.js>; rel=preload; as=script"
        Header add Link "<fx.js>; rel=preload; as=script"
    </FilesMatch>
</IfModule>